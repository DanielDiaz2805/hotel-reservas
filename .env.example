# Copia este archivo como .env.local y completa los valores.

# Cadena de conexión de MongoDB Atlas (incluye el nombre de la base de datos "hotel")
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/hotel?retryWrites=true&w=majority

# Clave para firmar las sesiones (mínimo 32 caracteres). Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Celular de WhatsApp del hotel, 10 dígitos sin +57
WHATSAPP_HOTEL=3001234567

# Opcional: muestra el botón "Entrar como demostración" en /ingresar
DEMO_EMAIL=
DEMO_PASSWORD=
